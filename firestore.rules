rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidVideo(data) {
      return data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 2000 &&
        (!('titleEn' in data) || (data.titleEn is string && data.titleEn.size() <= 2000)) &&
        data.url is string && data.url.size() >= 5 && data.url.size() <= 8000 &&
        (!('embedUrl' in data) || (data.embedUrl is string && data.embedUrl.size() <= 12000)) &&
        (!('previewVideoUrl' in data) || (data.previewVideoUrl is string && data.previewVideoUrl.size() <= 25000)) &&
        (!('mediaType' in data) || data.mediaType in ['video', 'gallery', 'mixed']) &&
        (!('images' in data) || (data.images is list && data.images.size() <= 50)) &&
        data.platform in ['facebook', 'youtube', 'direct', 'other'] &&
        data.category in ['បច្ចេកវិទ្យា', 'វិទ្យាសាស្ត្រ', 'ចំណេះដឹងទូទៅ', 'ប្រវត្តិសាស្ត្រ', 'សុខភាព & ខួរក្បាល', 'គន្លឹះខ្លីៗ'] &&
        (!('description' in data) || (data.description is string && data.description.size() <= 30000)) &&
        (!('thumbnail' in data) || (data.thumbnail is string && data.thumbnail.size() <= 950000)) &&
        (!('duration' in data) || (data.duration is string && data.duration.size() <= 100)) &&
        (!('views' in data) || (data.views is number && data.views >= 0)) &&
        (!('likes' in data) || (data.likes is number && data.likes >= 0)) &&
        (!('shares' in data) || (data.shares is number && data.shares >= 0)) &&
        (!('publishDate' in data) || (data.publishDate is string && data.publishDate.size() <= 50)) &&
        data.status in ['published', 'draft', 'scheduled'] &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 50)) &&
        (!('isFavorite' in data) || (data.isFavorite is bool)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 20000)) &&
        (!('creatorChecklist' in data) || (data.creatorChecklist is map));
    }

    // Video collection
    match /videos/{videoId} {
      allow read: if true;
      allow create: if isValidId(videoId) &&
                    isValidVideo(incoming()) &&
                    incoming().id == videoId;
      allow update: if isValidId(videoId) &&
                    isValidVideo(incoming()) &&
                    incoming().id == existing().id;
      allow delete: if isValidId(videoId);
    }

    // Application settings (e.g. security configuration, passcode sync, and channel stats)
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId) &&
                    ((settingId == 'security' && incoming().passcode is string && incoming().passcode.size() >= 4 && incoming().passcode.size() <= 64) ||
                     (settingId != 'security'));
    }
  }
}
